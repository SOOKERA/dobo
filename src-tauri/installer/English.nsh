; [APP] The line under the progress bar while ${APP_EXE} is copied: "Copying ${APP_EXE}... 40%".
; NSIS reads ^Extract in the language Setup started in, so with French on it holds a variable that
; Setup sets to the words of the language shown (installer/ui.nsh: AppLangTexts).
!insertmacro AppEn appExtract "Copying "
!if ${APP_FRENCH} == 1
  LangString ^Extract ${LANG_ENGLISH} "$AppTxExtract"
!else
  LangString ^Extract ${LANG_ENGLISH} "Copying "
!endif
