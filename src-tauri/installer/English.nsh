!insertmacro AppEn appNextSlide "Next slide"
!insertmacro AppEn appChoicesFailed "${APP_CHOICES_FAILED}"
!insertmacro AppEn appFailInstall "Couldn’t finish installing: Windows didn’t allow writing in $INSTDIR."
!insertmacro AppEn appFailFile "Couldn’t replace $AppFailName: another program may be using it. Close it, then run ${APP_NAME} Setup again."
!insertmacro AppEn appFolderData "${APP_NAME} keeps your notes in this folder. Pick another one."
; [APP] WebView2's data folder (app.nsh APP_WEBVIEW_DIR): not the notes.
!insertmacro AppEn appFolderWebview "${APP_NAME} keeps its own files in this folder. Pick another one."
!insertmacro AppEn appFolderPortable "A portable ${APP_NAME} is in this folder. Pick another one, so its notes stay with it."
!insertmacro AppEn appFolderPick "Pick a folder to install ${APP_NAME} in."
!insertmacro AppEn appIsOpen "${APP_NAME} is open: Setup closes it first. ${APP_IS_OPEN_NOTE}"
!insertmacro AppEn appInstalling "Installing ${APP_NAME}…"
!insertmacro AppEn appUpdating "Updating ${APP_NAME}…"
