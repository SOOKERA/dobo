; ${APP_NAME} Setup's English text: Tauri's own English file (tauri-cli 2.12) with plainer wording for
; closing ${APP_NAME}, for replacing an older version (installer/installer.nsi then only removes the old
; files, see "[APP]" there) and for the uninstaller's "delete data" box ("Also delete my notes", Dobo's exact label). Tauri needs every
; string it uses here: after a tauri-cli update, compare with its English.nsh and add any new one.
;
; [APP] Each line is `!insertmacro AppEn <name> "<text>"` (installer/ui.nsh): it makes both Tauri's
; LangString <name> (read as $(name) by Tauri's own code) and the define AppEn_<name>, which
; Setup's window reads through AppT, so that its words can switch to French and back while it is
; open (a LangString always gives the language Setup started in). French.nsh has the same names.
!insertmacro AppEn addOrReinstall "Add/Reinstall components"
!insertmacro AppEn alreadyInstalled "Already Installed"
!insertmacro AppEn alreadyInstalledLong "${PRODUCTNAME} ${VERSION} is already installed. Select the operation you want to perform and click Next to continue."
!insertmacro AppEn appRunning "{{product_name}} is open. Close it first, then try again."
!insertmacro AppEn appRunningOkKill "{{product_name}} is open.$\nClick OK to close it and continue."
!insertmacro AppEn chooseMaintenanceOption "Choose the maintenance option to perform."
!insertmacro AppEn chooseHowToInstall "Choose how you want to install ${PRODUCTNAME}."
!insertmacro AppEn createDesktop "Create desktop shortcut"
!insertmacro AppEn dontUninstall "Do not uninstall"
!insertmacro AppEn dontUninstallDowngrade "Do not uninstall (Downgrading without uninstall is disabled for this installer)"
!insertmacro AppEn failedToKillApp "Couldn’t close {{product_name}}. Close it first, then try again."
; (tauri-cli 2.12.5's utils.nsh says it when Windows doesn't let Setup close the app.)
!insertmacro AppEn noPermissionToCloseApp "{{product_name}} can’t be closed from here. Close it yourself, then try again."
!insertmacro AppEn installingWebview2 "Installing WebView2..."
!insertmacro AppEn newerVersionInstalled "A newer version of ${PRODUCTNAME} is already installed! It is not recommended that you install an older version. If you really want to install this older version, it’s better to uninstall the current version first. Select the operation you want to perform and click Next to continue."
!insertmacro AppEn older "older"
!insertmacro AppEn olderOrUnknownVersionInstalled "An $R4 version of ${PRODUCTNAME} is installed. ${APP_NAME} Setup replaces it: your notes, settings, shortcuts and taskbar pin stay. Click Next to continue."
!insertmacro AppEn silentDowngrades "Downgrades are disabled for this installer, can't proceed with the silent installer, please use the graphical interface installer instead.$\n"
!insertmacro AppEn unableToUninstall "Unable to uninstall!"
!insertmacro AppEn uninstallApp "Uninstall ${PRODUCTNAME}"
!insertmacro AppEn uninstallBeforeInstalling "Replace the installed version (recommended)"
!insertmacro AppEn unknown "unknown"
!insertmacro AppEn webview2AbortError "Failed to install WebView2! The app can’t run without it. Try restarting the installer."
!insertmacro AppEn webview2DownloadError "Error: Downloading WebView2 Failed - $0"
!insertmacro AppEn webview2DownloadSuccess "WebView2 bootstrapper downloaded successfully"
!insertmacro AppEn webview2Downloading "Downloading WebView2 bootstrapper..."
!insertmacro AppEn webview2InstallError "Error: Installing WebView2 failed with exit code $1"
!insertmacro AppEn webview2InstallSuccess "WebView2 installed successfully"
!insertmacro AppEn deleteAppData "Also delete my notes"
; [APP] A silent or passive install's folder check (installer/hooks.nsh: AppCheckDir).
!insertmacro AppEn appDirNotWritable "${APP_NAME} Setup installs ${APP_NAME} for you only, without admin rights, so it needs a folder you can change. Windows doesn’t let you change $INSTDIR (folders like Program Files need admin rights).$\n$\nPick another folder, for example $LOCALAPPDATA\Programs\${APP_NAME}."
!insertmacro AppEn appDirNotWritableSilent "${APP_NAME} Setup installs ${APP_NAME} for you only, without admin rights, so it needs a folder you can change. Windows doesn't let you change $INSTDIR (folders like Program Files need admin rights). Pick another folder with /D=, for example /D=$LOCALAPPDATA\Programs\${APP_NAME}$\n"
; [APP] ${APP_NAME} Setup's own window (installer/ui.nsh). Plain words, the window's exact labels.
!insertmacro AppEn appSetupTitle "${APP_NAME} Setup"
!insertmacro AppEn appVersion "Version ${VERSION}"
!insertmacro AppEn appTag "${APP_TAGLINE}"
!insertmacro AppEn appTagUpdate "Updates ${APP_NAME} $AppOldVersion to ${VERSION}"
!insertmacro AppEn appTagSame "${APP_NAME} ${VERSION} is installed: this installs it again"
!insertmacro AppEn appTagOlder "Puts back ${APP_NAME} ${VERSION} (you have $AppOldVersion)"
!insertmacro AppEn appUpdateTitle "Update ${APP_NAME}"
!insertmacro AppEn appInstallIn "Install in"
!insertmacro AppEn appChange "Change"
!insertmacro AppEn appPickFolder "Pick where to install ${APP_NAME}. ${APP_NAME} gets a folder of its own in it."
!insertmacro AppEn appDesktop "Desktop shortcut"
!insertmacro AppEn appStartWithWindows "Start ${APP_NAME} with Windows"
!insertmacro AppEn appBrowsers "Connect ${APP_NAME} to your browsers"
!insertmacro AppEn appBrowsersSub "So the browser extension can talk to ${APP_NAME}"
