; ${APP_NAME} Setup's French text (template 1.1.0): the same names as English.nsh, in the studio's
; French (calm, short, « vous »; appli, never « app »; Paramètres, Installer, Désinstaller, Démarrer
; avec Windows, Raccourci sur le Bureau, Version portable, Annuler). Only for an app with French on
; (app.nsh: !define APP_FRENCH 1, and tauri.conf.json: "languages": ["English", "French"] with
; "customLanguageFiles": { "French": "installer/French.nsh" }).
;
; Typography is written in the texts themselves: a no-break space (U+00A0) before « : » and inside
; « », a narrow one (U+202F) before ; ! ? and ’ for the apostrophe. They look like plain spaces
; here: keep them when editing (or retype them). Saved as UTF-8 (Tauri runs makensis with
; -INPUTCHARSET UTF8 and copies this file with a BOM).
;
; [APP] Dobo: the same rewordings as its English.nsh (« Supprimer aussi mes notes », « vos notes »
; for « paramètres et listes », appFolderWebview), in Dobo's French (glossary: src/lib/i18n/fr.ts).
!if ${APP_FRENCH} != 1
  !error "French.nsh is included (tauri.conf.json languages) but app.nsh doesn't turn French on: add !define APP_FRENCH 1 there, or take French out of languages."
!endif
!define APP_FRENCH_TEXTS
!insertmacro AppFr addOrReinstall "Ajouter ou réinstaller des composants"
!insertmacro AppFr alreadyInstalled "Déjà installé"
!insertmacro AppFr alreadyInstalledLong "${PRODUCTNAME} ${VERSION} est déjà installé. Choisissez ce que vous voulez faire, puis cliquez sur Suivant."
!insertmacro AppFr appRunning "{{product_name}} est ouvert. Fermez-le d’abord, puis réessayez."
!insertmacro AppFr appRunningOkKill "{{product_name}} est ouvert.$\nCliquez sur OK pour le fermer et continuer."
!insertmacro AppFr chooseMaintenanceOption "Choisissez l’opération de maintenance à effectuer."
!insertmacro AppFr chooseHowToInstall "Choisissez comment installer ${PRODUCTNAME}."
!insertmacro AppFr createDesktop "Créer un raccourci sur le Bureau"
