{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The board (the main Dobo window): all of Dobo's own commands, and the few window, event and dialog calls the page makes",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "dialog:allow-open",
    "allow-load-all",
    "allow-create-note",
    "allow-update-note",
    "allow-delete-note",
    "allow-reorder-notes",
    "allow-create-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-set-setting",
    "allow-language-now",
    "allow-inbox-for",
    "allow-drop-empty-inbox",
    "allow-count-sticky-notes",
    "allow-import-sticky-notes",
    "allow-window-info",
    "allow-hide-panel",
    "allow-apply-window",
    "allow-set-float-on-top",
    "allow-list-monitors",
    "allow-answer-ring",
    "allow-page-ready",
    "allow-tidy-answer",
    "allow-rhythm-presets",
    "allow-show-dump",
    "allow-hide-dump",
    "allow-dump-item",
    "allow-fetch-preview",
    "allow-set-item-link",
    "allow-open-path",
    "allow-open-url",
    "allow-report-info",
    "allow-report-send",
    "allow-report-mail",
    "allow-save-picture",
    "allow-add-picture-file",
    "allow-delete-picture",
    "allow-make-thumb",
    "allow-release-picture",
    "allow-set-shortcut",
    "allow-shortcuts-taken",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-restore",
    "allow-open-note",
    "allow-end-peek",
    "allow-save-note-image",
    "allow-reveal",
    "allow-backup-now",
    "allow-backup-list",
    "allow-backup-restore",
    "allow-backup-status",
    "allow-backup-folder",
    "allow-data-info",
    "allow-open-data-folder",
    "allow-dark-mode-now",
    "allow-export-look",
    "allow-import-look",
    "allow-pick-background-picture",
    "allow-resize-docked",
    "allow-set-pinned",
    "allow-accept-terms",
    "allow-quit-app",
    "allow-update-status",
    "allow-update-check",
    "allow-update-restart",
    "allow-recovery-state",
    "allow-recovery-choose",
    "allow-recovery-continue"
  ]
}
