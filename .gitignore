node_modules/
# The page Vite builds (bundled into Dobo.exe), and the release files (scripts/release.ps1).
/build/
dist/
src-tauri/target/
src-tauri/gen/
# Made by every build from build.rs's COMMANDS (one permission per command of Dobo's own).
src-tauri/permissions/autogenerated/
*.log
.DS_Store

# Development builds keep their notes here (src-tauri/src/paths.rs).
/data/

# Private working files: never part of the source repository. (docs/help and docs/screenshots
# are public: the release builds help.zip from docs/help.)
/PLAN.md
/PLAN-history.md
/design/
/docs/website/
/HANDOFF.md
/.claude/

# Secrets (an update signing key, local settings): never commit.
.env
.env.*
signing/

# Local build settings (they hold this PC's paths).
src-tauri/.cargo/
